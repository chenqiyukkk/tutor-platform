DATABASE_URL="postgresql://tutor:tutor@127.0.0.1:5432/tutor_platform?schema=public"
SESSION_SECRET="replace-this-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"

# Development/test only. Use an absolute private directory outside this repository.
# Local verification uploads are hard-disabled when NODE_ENV=production.
# On Windows, restrict this directory's ACL to the application identity; POSIX mode bits do not enforce Windows ACLs.
VERIFICATION_UPLOAD_DIR="/absolute/private/path/verification-uploads"

# Required together in production. Development and test use the console adapter.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-password"
SMTP_FROM="Tutor Platform <no-reply@example.com>"
